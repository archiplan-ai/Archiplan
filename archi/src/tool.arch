import data
import conns
import views
import lang

// crates/archi — the runner and the archiplan subsystems around the language.

def node SourceTree:
  port serve // module texts, docs, plan.json, journal events, code items
  port store // every write lands here: the tree is the only persistence

def node Cli:
  port check       // compile model + docs + archive, report findings
  port build       // compile, optionally emit the lowered batch
  port nkp         // landscape analysis verb
  port incidence   // incidence analysis verb
  port version     // save, anchor, remint, list, show, diff (archived or live), current
  port session     // fold: two concurrent rounds into one deliberate record
  port req         // add, rm: requirement skeletons minted and retired by verb
  port stress      // open, add, rm: the round's records minted and retired by verb
  port link        // add, ls, verify, confirm, rm, repin, capture, audit
  port repo        // ls, map: the member registry and its local mappings
  port plan        // use, task add, verify, start, next, close, reset
  port query       // one composed subgraph query
  port read        // the agent read envelope over stdin/argv
  port search      // ranked retrieval by phrase across model defs and doc objects
  port init        // manifest + source dir + starter + briefing, create-only — the verb before a project exists
  port worktree    // mint, ls, drop, merge: the seat lifecycle
  port status      // where am I: checkout, binding, version state, open work
  port update      // check-update, update: the binary against the release feed's latest
  port compile_src // drives the compiler
  port exec        // replays the lowered batch on the engine
  port ask         // read statements to the engine's envelope
  port drive       // consults every subsystem, one verb at a time

def node DocsCompiler:
  port compile_docs // parse + schema + cross-check docs against the model
  port load_docs    // pulls requirement and stress markdown from the tree
  port pin_model    // reconstructs archived versions for pinned checks
  port compile_pin  // compiles a reconstructed render through the compiler
  port serve_pin    // hands pinned models to incidence, links and plans

// crates/archi/src/docs/mint.rs — skeletons come from verbs: schema shape
// out, text slots empty, placement derived from the tree's invariants.
def node DocMint:
  port mint      // req add, stress open, stress add: the exact schema shape, slots empty
  port remove    // req rm, stress rm: the blast radius pre-flighted, sealed history refused
  port read_tree // the best-effort doc tree: intents, slugs, the open round
  port pin       // the open round's version, reconstructed to resolve affects
  port emit      // skeleton files into the tree

def node Search:
  port find      // phrase in, ranked cards out: one scan per query, no second store
  port read_docs // requirement and stress markdown out of the tree, best-effort

def node Scaffold:
  port stand_up  // one target directory in, the created/kept report out
  port emit      // the missing artifacts, in an order that keeps every intermediate tree honest: manifest last
  port read_tree // what the target already holds — manifest, modules, briefing — read before any write

// crates/archi/src/update.rs — the binary against the release feed's latest:
// curl and tar through Command, the swap an atomic rename over current_exe.
def node Updater:
  port check // the feed's latest tag against the compiled-in number: up to date, or the drift named by direction
  port fetch // the platform tarball of latest from the release assets, checksum-verified in a scratch dir
  port swap  // the running binary replaced by rename; equal versions converge, torn or tampered fetches change nothing

// The member registry: declared repositories resolved to local roots, home implicit.
def node Members:
  port resolve    // manifest defaults under local overrides: member names to roots, absent checkouts reported unreachable
  port survey     // the doctor's read per member: mapped, reachable, clean, head, baseline
  port read_decls // declarations and local mapping rows out of the tree

def node Archive:
  port save         // canonical render in; keyframe or patch + manifest entry, one baseline per clean mapped member
  port anchor       // post-hoc commit provenance: clean tree, render-hash match; per member, the clean-tree half alone
  port locate       // the member roots a save or anchor baselines against
  port remint       // re-mint a round's save onto the merged lineage; re-stamps the session's closed:
  port serve        // reconstructs any version, verified against its seal
  port canonicalize // consults the renderer for the canonical bytes

def node Sessions:
  port fold         // two rounds into one record: both charters kept, the trace in the file
  port read_state   // the merged state it folds: fused files, the open pair, their pins
  port store_record // the folded record lands in the tree

def node Links:
  port record      // add, confirm, rm, repin: journal events
  port verify      // recomputes projections, grades drift per link kind
  port sweep       // audit: dark deltas, dark spec, decayed evidence
  port capture     // wave delta to candidate links, pre-attributed by task
  port read_code   // code items out of the tree: candidate and wave scans
  port read_index  // wave-open indexes out of the tree
  port locate      // member roots for grading and the audit
  port locate_scan // member roots for the wave scan
  port journal     // appends link events to the journal in the tree
  port pin_spec    // resolves pinned spec refs via reconstructed versions
  port serve_links // the folded live set, read by the plan's coverage gate

  def node Journal:   // the append-only truth; the live set is its fold
    port record_events
    port append
    port flush
    port serve_fold
  def node Canonizer: // rust-tok-v1 / text-v1: the versioned hash contract
    port hash
  def node Grader:    // recomputes projections, grades states — unreachable distinct from missing — and audits per member
    port grade
    port audit
    port resolve_pins
    port canon
    port read_fold
    port scan_code
    port locate
  def node Capture:   // wave-open index vs the mapped trees: mints, touches, decays; the scan set recorded at open
    port diff_wave
    port load_index
    port canon
    port mint
    port locate

  Grader.canon canonize Canonizer.hash in trace_flow
  Capture.canon canonize Canonizer.hash in trace_flow
  Grader.read_fold recall(LinkEvent) Journal.serve_fold in trace_flow
  Capture.mint persist(LinkEvent) Journal.append in trace_flow
  record = Journal.record_events
  verify = Grader.grade
  sweep = Grader.audit
  pin_spec = Grader.resolve_pins
  capture = Capture.diff_wave
  journal = Journal.flush
  serve_links = Journal.serve_fold
  read_code = Grader.scan_code
  read_index = Capture.load_index
  locate = Grader.locate
  locate_scan = Capture.locate

def node Planner:
  port author      // use, task add: pins a version, seeds spec_refs
  port advance     // start, next: waves, gates, scenario latches
  port pin_model   // the hardened version the plan projects
  port store_plan  // plan.json and wave indexes land in the tree
  port load_plan   // re-reads and re-validates plan.json on every verb
  port run_capture // fires the wave capture at each close
  port coverage    // reads the folded links for the asserted-coverage gate

Storage type_of SourceTree
Storage type_of Archive
Function type_of Members
Service type_of Cli
Function type_of DocsCompiler
Function type_of Search
Function type_of DocMint
Function type_of Scaffold
Function type_of Updater
Service type_of Links
Service type_of Planner
Service type_of Sessions

// the compiler and the engine read their inputs out of the tree
Compiler.load_sources recall(ArchSource) SourceTree.serve in compile_flow

// the cli drives one flow per verb
Cli.compile_src compile Compiler.compile in compile_flow
Cli.exec execute Engine.execute in compile_flow
Cli.ask interrogate Engine.answer in read_flow
Cli.drive consult(->ModelGraph, <-Findings) Query.audit in read_flow
Cli.drive consult(->ModelGraph, <-NkpReport) Nkp.scan in read_flow
Cli.drive consult(->ModelGraph, <-IncidenceReport) Incidence.scan in harden_flow
Cli.drive consult(->ModelGraph, <-Report) Archive.save in harden_flow
Cli.drive consult(->ModelGraph, <-Report) Archive.anchor in harden_flow
Cli.drive consult(->ModelGraph, <-Report) Archive.remint in harden_flow
Cli.drive consult(->Command, <-Report) Sessions.fold in harden_flow
Cli.drive consult(->ModelGraph, <-Diagnostics) DocsCompiler.compile_docs in harden_flow
Cli.drive consult(->Command, <-Report) Links.record in trace_flow
Cli.drive consult(->Command, <-Report) Links.verify in trace_flow
Cli.drive consult(->Command, <-Report) Links.sweep in trace_flow
Cli.drive consult(->Command, <-Report) Planner.author in trace_flow
Cli.drive consult(->Command, <-Report) Planner.advance in trace_flow
Cli.drive consult(->Command, <-Report) Members.survey in trace_flow

// members: declarations from the tree, one resolution serving every scan and baseline
Members.read_decls recall(MemberDecl) SourceTree.serve in trace_flow
Links.locate recall(MemberSet) Members.resolve in trace_flow
Links.locate_scan recall(MemberSet) Members.resolve in trace_flow
Archive.locate recall(MemberSet) Members.resolve in harden_flow

// doc skeletons: minted and retired by verb, validated against the tree and the pin
Cli.drive consult(->Command, <-Report) DocMint.mint in harden_flow
Cli.drive consult(->Command, <-Report) DocMint.remove in harden_flow
DocMint.read_tree recall(RequirementDoc) SourceTree.serve in harden_flow
DocMint.read_tree recall(StressDoc) SourceTree.serve in harden_flow
DocMint.pin recall(CanonicalRender) Archive.serve in harden_flow
DocMint.emit persist(RequirementDoc) SourceTree.store in harden_flow
DocMint.emit persist(StressDoc) SourceTree.store in harden_flow

// search: one scan over the docs and the model it was handed, ranked cards out
Cli.drive consult(->ModelGraph, <-SearchReport) Search.find in read_flow
Search.read_docs recall(RequirementDoc) SourceTree.serve in read_flow
Search.read_docs recall(StressDoc) SourceTree.serve in read_flow

// init: read what exists, emit what is missing — the one verb with no project to locate
Cli.drive consult(->Command, <-Report) Scaffold.stand_up in compile_flow
Scaffold.read_tree recall(ArchSource) SourceTree.serve in compile_flow
Scaffold.read_tree recall(AgentBrief) SourceTree.serve in compile_flow
Scaffold.emit persist(ArchSource) SourceTree.store in compile_flow
Scaffold.emit persist(AgentBrief) SourceTree.store in compile_flow

// self-update: the one flow that leaves the machine — curl out, rename home
Cli.drive consult(->Command, <-Report) Updater.check in read_flow
Cli.drive consult(->Command, <-Report) Updater.fetch in compile_flow
Cli.drive consult(->Command, <-Report) Updater.swap in compile_flow

// docs cross-check: markdown in, pinned models on demand
DocsCompiler.load_docs recall(RequirementDoc) SourceTree.serve in harden_flow
DocsCompiler.load_docs recall(StressDoc) SourceTree.serve in harden_flow
DocsCompiler.pin_model recall(CanonicalRender) Archive.serve in harden_flow
DocsCompiler.compile_pin compile Compiler.compile in harden_flow

// the archive canonicalizes through the renderer
Archive.canonicalize render Renderer.emit_source in harden_flow

// sessions: the round record folds through a verb, never a hand merge
Sessions.read_state recall(StressDoc) SourceTree.serve in harden_flow
Sessions.store_record persist(StressDoc) SourceTree.store in harden_flow

// incidence reads sessions and expands affects against pinned versions
Incidence.read_sessions recall(StressDoc) SourceTree.serve in harden_flow
Incidence.pin_model recall(ModelGraph) DocsCompiler.serve_pin in harden_flow

// links: journal in the tree, symbols from the tree, pins via docs
Links.read_code recall(CodeItem) SourceTree.serve in trace_flow
Links.read_index recall(ItemHashIndex) SourceTree.serve in trace_flow
Links.journal persist(LinkEvent) SourceTree.store in trace_flow
Links.pin_spec recall(ModelGraph) DocsCompiler.serve_pin in trace_flow

// plans: pin, author, execute in waves, gate on asserted coverage
Planner.pin_model recall(ModelGraph) DocsCompiler.serve_pin in trace_flow
Planner.store_plan persist(PlanFile) SourceTree.store in trace_flow
Planner.store_plan persist(PlanState) SourceTree.store in trace_flow
Planner.store_plan persist(ItemHashIndex) SourceTree.store in trace_flow
Planner.load_plan recall(PlanFile) SourceTree.serve in trace_flow
Planner.load_plan recall(PlanState) SourceTree.serve in trace_flow
Planner.run_capture consult(->ItemHashIndex, <-LinkEvent) Links.capture in trace_flow
Planner.coverage recall(LinkEvent) Links.serve_links in trace_flow
